{
  /* O Node roda os .ts direto (removendo os tipos na hora); o tsc só confere os tipos.
     Por isso: noEmit, imports com a extensão .ts e só sintaxe que pode ser apagada (sem enum). */
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "skipLibCheck": true,

    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["core", "cli", "web/server.ts"]
}
